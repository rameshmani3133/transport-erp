# Local MySQL:
# DATABASE_URL="mysql://user:password@localhost:3306/transport_erp"

# Aiven MySQL:
# DATABASE_URL="mysql://avnadmin:YOUR_AIVEN_PASSWORD@YOUR_AIVEN_HOST:PORT/defaultdb?ssl-mode=REQUIRED"
DATABASE_URL="mysql://avnadmin:YOUR_AIVEN_PASSWORD@YOUR_AIVEN_HOST:PORT/defaultdb?ssl-mode=REQUIRED"
PORT=3000
CORS_ORIGIN=http://localhost:5173
AUTH_SECRET=replace-with-48-byte-random-secret
AUTH_TOKEN_TTL_HOURS=12
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_PASSWORD=replace-with-strong-password
SUPERADMIN_TENANT=default
BACKUP_DAILY_TIME=02:00
BACKUP_LOCAL_DIR=./backups/local
BACKUP_CLOUD_DIR=
BACKUP_CLOUD_COMMAND=

# Email reminders through Brevo transactional email API.
# Create a Brevo account, verify the sender email, then set these values in Render/local .env.
BREVO_API_KEY=
REMINDER_FROM_EMAIL=
REMINDER_FROM_NAME="Transport ERP"
# Optional global fallback only. Company/user reminder emails are stored inside the app.
REMINDER_TO_EMAIL=
REMINDER_DAYS_AHEAD=30
REMINDER_EMAIL_ENABLED=false
REMINDER_DAILY_TIME=08:00
REMINDER_TENANT=default
