generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MASTER DATA MODULES
// ==========================================

model Vehicle {
  id                Int       @id @default(autoincrement())
  tenantKey         String    @default("default")
  deletedAt       DateTime?
  regNo             String    
  type              String?
  capacityTon       Float?    
  ownershipType     String?
  ownerName         String?
  regDate           DateTime?
  fcExpiry          DateTime?
  permit1YrExpiry   DateTime?
  permit5YrExpiry   DateTime?
  qTaxExpiry        DateTime?
  pucExpiry         DateTime?
  insuranceExpiry   DateTime?
  cllExpiry         DateTime?
  pliExpiry         DateTime?
  explosiveExpiry   DateTime?
  fitmentDetails    String?   
  status            String?   @default("Active")
  rule18Expiry      DateTime?
  rule19Expiry      DateTime?
  rule43Expiry      DateTime?
  pesoExpiry        DateTime?
  sv1Num            String?
  sv2Num            String?
  sv3Num            String?
  iv1Num            String?
  iv2Num            String?
  iv3Num            String?
  sv1Expiry         DateTime?
  sv2Expiry         DateTime?
  sv3Expiry         DateTime?
  iv1Expiry         DateTime?
  iv2Expiry         DateTime?
  iv3Expiry         DateTime?
  
  trips             Trip[]
  diesels           Diesel[]
  ledgerEntries     LedgerEntry[]
  settlements       VendorSettlement[]
  loans             Loan[]

  vendorAccountId Int?
  vendorAccount   Account? @relation("VehicleVendor", fields: [vendorAccountId], references: [id])

  @@unique([tenantKey, regNo])
}

model Driver {
  id              Int       @id @default(autoincrement())
  tenantKey       String    @default("default")
  deletedAt       DateTime?
  name            String
  licenseNo       String
  licenseExpiry   DateTime
  hazmatLicense   Boolean   @default(false)
  hazmatExpiry    DateTime?
  address         String?
  phone           String
  aadhaarNumber   String
  status          String    @default("Active")
  
  diesels         Diesel[]
  trips           Trip[]    
  driverSettlements DriverSettlement[] 

  @@unique([tenantKey, licenseNo])
  @@unique([tenantKey, aadhaarNumber])
}

model ClientCompany {
  id            Int               @id @default(autoincrement())
  tenantKey     String            @default("default")
  deletedAt       DateTime?
  companyName   String
  panNumber     String?
  vendorCode    String?
  status        String            @default("Active")
  
  locations     BillingLocation[]
  routes        RouteMaster[]     
  trips         Trip[]            

  @@unique([tenantKey, companyName])
}

model BillingLocation {
  id            Int               @id @default(autoincrement())
  tenantKey     String            @default("default")
  deletedAt       DateTime?
  locationName  String            
  address       String?
  gstNumber     String?
  invoiceFormat String            @default("Standard") 
  companyId     Int
  company       ClientCompany     @relation(fields: [companyId], references: [id])
  
  invoices      Invoice[]
}

model RouteMaster {
  id              Int             @id @default(autoincrement())
  tenantKey       String          @default("default")
  deletedAt       DateTime?
  companyId       Int
  company         ClientCompany   @relation(fields: [companyId], references: [id])
  fromLocation    String
  toLocation      String
  rtkm            Float           
  calcType        String          @default("PerTon") 
  defaultRate     Float           @default(0)
  
  trips           Trip[]
}

model Loan {
  id              Int       @id @default(autoincrement())
  tenantKey       String    @default("default")
  deletedAt       DateTime?
  loanNo          String?
  lenderName      String
  lenderBankName  String?
  lenderAccountNo String?
  lenderIfscCode  String?
  lenderBranch    String?
  paymentStatus   String    @default("Due")
  paidDate        DateTime?
  financeAccountId Int?
  financeAccount  Account?  @relation("FinanceLoans", fields: [financeAccountId], references: [id])
  vehicleId       Int?
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id])
  principalAmount Float     @default(0)
  outstandingAmount Float   @default(0)
  emiAmount       Float     @default(0)
  dueDay          Int?
  nextDueDate     DateTime
  startDate       DateTime?
  endDate         DateTime?
  status          String    @default("Active")
  remarks         String?

  @@unique([tenantKey, loanNo])
}

// ==========================================
// MONTHLY / RECURRING BILL TRACKING
// ==========================================

model RecurringBill {
  id               Int       @id @default(autoincrement())
  tenantKey        String    @default("default")
  deletedAt        DateTime?
  category         String
  billName         String
  providerName     String?
  consumerNumber   String?
  amount           Float
  dueDay           Int
  nextDueDate      DateTime
  paymentStatus    String    @default("Due")
  lastPaidDate     DateTime?
  reminderEnabled  Boolean   @default(true)
  startDate        DateTime?
  endDate          DateTime?
  status           String    @default("Active")
  remarks          String?
  expenseAccountId Int?
  payableAccountId Int?
  payments         RecurringBillPayment[]

  @@index([tenantKey, nextDueDate])
}

model RecurringBillPayment {
  id               Int       @id @default(autoincrement())
  tenantKey        String    @default("default")
  deletedAt        DateTime?
  recurringBillId  Int
  recurringBill    RecurringBill @relation(fields: [recurringBillId], references: [id])
  dueDate          DateTime
  paidDate         DateTime
  amount           Float
  paymentMode      String?
  referenceNumber  String?
  remarks          String?
  createdAt        DateTime  @default(now())

  @@index([tenantKey, recurringBillId])
}

// ==========================================
// CORE OPERATIONS: TRIP MANAGEMENT
// ==========================================

model Trip {
  id              Int             @id @default(autoincrement())
  tenantKey       String          @default("default")
  deletedAt       DateTime?
  tripNo          String
  date            DateTime        @default(now())
  docNumber       String?         
  
  companyId       Int
  company         ClientCompany   @relation(fields: [companyId], references: [id])
  routeId         Int
  route           RouteMaster     @relation(fields: [routeId], references: [id])
  vehicleId       Int
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  driverId        Int?
  driver          Driver?         @relation(fields: [driverId], references: [id])
  
  invoiceId       Int?
  invoice         Invoice?        @relation(fields: [invoiceId], references: [id])
  settlementId    Int?
  settlement      VendorSettlement? @relation(fields: [settlementId], references: [id])
  
  driverSettlementId Int?
  driverSettlement   DriverSettlement? @relation(fields: [driverSettlementId], references: [id])
  
  tripKm          Float?          @default(0)
  
  dieselAccountId Int?
  dieselAccount   Account?        @relation("DieselAccountTrips", fields: [dieselAccountId], references: [id])
  advanceAccountId Int?
  advanceAccount  Account?        @relation("AdvanceAccountTrips", fields: [advanceAccountId], references: [id])
  clientAdvanceAccountId Int?
  clientAdvanceAccount Account?    @relation("ClientAdvanceAccountTrips", fields: [clientAdvanceAccountId], references: [id])
  clientAdvanceClientAccountId Int?
  clientAdvanceClientAccount Account? @relation("ClientAdvanceClientAccountTrips", fields: [clientAdvanceClientAccountId], references: [id])
  
  dieselLiters    Float           @default(0)
  dieselRate      Float           @default(0)
  dieselAmount    Float           @default(0)
  
  advanceDate     DateTime?
  advancePaid     Float           @default(0)
  clientAdvanceDate   DateTime?
  clientAdvanceAmount Float        @default(0)
  
  trailerLength   Float?
  trailerWidth    Float?
  trailerHeight   Float?
  billWeight      Float           @default(0)
  guaranteeWeight Float           @default(0)
  netWeight       Float           @default(0) 
  extraSizeFeet   Float           @default(0)
  haltingDays     Float           @default(0)
  
  clientCalcType        String    @default("PerTon") 
  clientRate            Float     @default(0)
  clientFreight         Float     @default(0)
  overWeightCharge      Float     @default(0)
  clientHaltingRate     Float     @default(0) 
  haltingCharge         Float     @default(0) 
  clientExtraSizeRate   Float     @default(0) 
  clientExtraSizeCharge Float     @default(0) 
  totalClientBill       Float     @default(0)
  
  vendorCalcType        String    @default("PerTon")
  vendorRate            Float     @default(0)
  vendorFreight         Float     @default(0)
  vendorHaltingRate     Float     @default(0) 
  vendorHaltingCharge   Float     @default(0) 
  vendorExtraSizeRate   Float     @default(0) 
  vendorExtraSizeCharge Float     @default(0) 
  commission            Float     @default(0)
  otherDeduction        Float     @default(0)
  netTruckPayout        Float     @default(0)
  remarks               String?

  // ========================================
  // DRIVER ON-ROAD EXPENSES (Filled at Payroll)
  // ========================================
  rtoPc             Float     @default(0)
  parking           Float     @default(0)
  loading           Float     @default(0)
  unloading         Float     @default(0)
  otherBillsAmount  Float     @default(0)
  otherBillsDesc    String?
  
  dieselBy              String    @default("Transporter") 
  status                String    @default("In-Transit") 
  
  diesels               Diesel[]
  ledgerEntries         LedgerEntry[]

  length                 Float?
  width                  Float?
  height                 Float?
  
  odcSize                Float?
  clientOdcRate          Float?   @default(0)
  vendorOdcRate          Float?   @default(0)  
  clientHaltRate         Float?   @default(0)
  vendorHaltRate         Float?   @default(0)

  @@unique([tenantKey, tripNo])
}

// ==========================================
// BILLING & INVOICING MODULE
// ==========================================

model Invoice {
  id              Int               @id @default(autoincrement())
  tenantKey       String            @default("default")
  deletedAt       DateTime?
  invoiceNo       String
  description     String?
  sacCode         String?
  vendorCode      String?
  poMigo          String?
  invoiceFormat   String            @default("Standard")
  periodFrom      DateTime?
  periodTo        DateTime?
  transportationMode String?
  vehicleNo       String?
  productService  String?
  gstType         String?
  gstPercent      Float             @default(0)
  declaration     String?
  showStatus      Boolean           @default(false)
  date            DateTime          @default(now())
  dueDate         DateTime?
  locationId      Int
  location        BillingLocation   @relation(fields: [locationId], references: [id])
  
  trips           Trip[]            
  subTotal        Float             @default(0) 
  cgst            Float             @default(0)
  sgst            Float             @default(0)
  igst            Float             @default(0)
  otherCharges    Float             @default(0) 
  grandTotal      Float             @default(0)
  
  advanceReceived Float             @default(0)
  totalPaid       Float             @default(0) 
  balanceAmount   Float             @default(0)
  status          String            @default("Unpaid") 
  
  payments        InvoicePayment[]
  ledgerEntries   LedgerEntry[]

  @@unique([tenantKey, invoiceNo])
}

model InvoicePayment {
  id              Int       @id @default(autoincrement())
  tenantKey       String    @default("default")
  deletedAt       DateTime?
  invoiceId       Int
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  paymentDate     DateTime  @default(now())
  amount          Float
  paymentMode     String    
  referenceNo     String?   
  remarks         String?
}

// ==========================================
// ACCOUNTING & GENERAL LEDGER MODULE
// ==========================================

model Account {
  id              Int       @id @default(autoincrement())
  tenantKey       String    @default("default")
  deletedAt       DateTime?
  accountName     String
  accountType     String    
  accountGroup    String    
  clientId        Int?
  driverId        Int?
  openingBalance  Float     @default(0)
  balanceType     String    @default("Dr") 
  
  parentAccountId Int?
  parentAccount   Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   Account[] @relation("AccountHierarchy")
  entries         LedgerEntry[]
  dieselTrips     Trip[]    @relation("DieselAccountTrips")
  advanceTrips    Trip[]    @relation("AdvanceAccountTrips")
  clientAdvanceTrips Trip[]  @relation("ClientAdvanceAccountTrips")
  clientAdvanceClientTrips Trip[] @relation("ClientAdvanceClientAccountTrips")
  vendorVehicles  Vehicle[] @relation("VehicleVendor")
  dieselPumps     Diesel[]  @relation("DieselPumpAccount")
  vendorSettlements VendorSettlement[] @relation("VendorSettlements")
  financeLoans    Loan[]    @relation("FinanceLoans")
  voucherLines    VoucherLine[]

  @@unique([tenantKey, accountName])
  @@unique([tenantKey, clientId])
  @@unique([tenantKey, driverId])
}

model LedgerEntry {
  id              Int       @id @default(autoincrement())
  tenantKey       String    @default("default")
  deletedAt       DateTime?
  date            DateTime  @default(now())
  
  accountId       Int
  account         Account   @relation(fields: [accountId], references: [id])
  type            String    
  amount          Float
  narration       String?   

  voucherId       Int?
  voucher         Voucher?  @relation(fields: [voucherId], references: [id])
  
  vehicleId       Int?
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id]) 
  
  tripId          Int?
  trip            Trip?     @relation(fields: [tripId], references: [id])    
  
  invoiceId       Int?
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id]) 
  
  dieselId        Int?
  diesel          Diesel?   @relation(fields: [dieselId], references: [id]) 
  
  settlementId    Int?
  settlement      VendorSettlement? @relation(fields: [settlementId], references: [id]) 
  
  driverSettlementId Int?
  driverSettlement   DriverSettlement? @relation(fields: [driverSettlementId], references: [id]) 
}

model Voucher {
  id              Int       @id @default(autoincrement())
  tenantKey       String    @default("default")
  deletedAt       DateTime?
  voucherNo       String
  requestKey      String?
  voucherType     String
  date            DateTime  @default(now())
  status          String    @default("Posted")
  totalAmount     Float
  paymentMode     String?
  referenceNo     String?
  narration       String
  remarks         String?
  sourceType      String?
  sourceId        Int?
  metadata        Json?
  reversalOfId    Int?
  reversalOf      Voucher?  @relation("VoucherReversal", fields: [reversalOfId], references: [id])
  reversals       Voucher[] @relation("VoucherReversal")
  lines           VoucherLine[]
  ledgerEntries   LedgerEntry[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantKey, voucherNo])
  @@unique([tenantKey, requestKey])
  @@index([tenantKey, date])
  @@index([tenantKey, voucherType])
}

model VoucherLine {
  id              Int       @id @default(autoincrement())
  tenantKey       String    @default("default")
  voucherId       Int
  voucher         Voucher   @relation(fields: [voucherId], references: [id])
  accountId       Int
  account         Account   @relation(fields: [accountId], references: [id])
  type            String
  amount          Float
  description     String?

  @@index([tenantKey, voucherId])
  @@index([tenantKey, accountId])
}

// ==========================================
// DIESEL MANAGEMENT MODULE
// ==========================================

model Diesel {
  id              Int       @id @default(autoincrement())
  tenantKey       String    @default("default")
  deletedAt       DateTime?
  date            DateTime  @default(now())
  
  vehicleId       Int
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id])
  tripId          Int?      
  trip            Trip?     @relation(fields: [tripId], references: [id])
  driverId        Int?
  driver          Driver?   @relation(fields: [driverId], references: [id])
  
  pumpAccountId   Int?
  pumpAccount     Account?  @relation("DieselPumpAccount", fields: [pumpAccountId], references: [id])
  pumpName        String?    
  paymentMode     String?    
  
  slipNumber      String?
  quantityLiters  Float
  ratePerLiter    Float
  totalAmount     Float
  
  ledgerEntries   LedgerEntry[]
}

// ==========================================
// VENDOR / TRUCK OWNER SETTLEMENT MODULE
// ==========================================

model VendorSettlement {
  id              Int       @id @default(autoincrement())
  tenantKey       String    @default("default")
  deletedAt       DateTime?
  settlementNo    String
  date            DateTime  @default(now())
  
  vehicleId       Int?      
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id])
  vendorId        Int?
  vendor          Account?  @relation("VendorSettlements", fields: [vendorId], references: [id])
  
  trips           Trip[]
  
  totalFreight    Float     @default(0) 
  totalHalting    Float     @default(0)
  totalExtraSize  Float     @default(0)
  grossAmount     Float     @default(0) 
  totalAdvances   Float     @default(0) 
  totalCommission Float     @default(0) 
  otherDeductions Float     @default(0) 
  netPayable      Float     @default(0)
  status          String    @default("Unpaid") 
  
  ledgerEntries   LedgerEntry[]

  @@unique([tenantKey, settlementNo])
}

// ==========================================
// DRIVER MONTHLY SETTLEMENT (PAYROLL) MODULE
// ==========================================

model DriverSettlement {
  id                Int       @id @default(autoincrement())
  tenantKey         String    @default("default")
  deletedAt       DateTime?
  settlementNo      String
  date              DateTime  @default(now())

  driverId          Int
  driver            Driver    @relation(fields: [driverId], references: [id])
  trips             Trip[]    

  // Bulk Driver Pay & Aggregates
  driverSalary      Float     @default(0) 
  totalExpenses     Float     @default(0)
  advanceDeducted   Float     @default(0) 
  netPayable        Float     @default(0) 

  ledgerEntries     LedgerEntry[]

  @@unique([tenantKey, settlementNo])
}

model MyCompanyProfile {
  id              Int      @id @default(autoincrement())
  tenantKey       String   @unique @default("default")
  deletedAt       DateTime?
  companyName     String
  address         String?
  gstNumber       String?
  panNumber       String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  signatoryRole   String? 
  reminderEmails  Json?
}


model User {
  id             Int                 @id @default(autoincrement())
  email          String              @unique
  name           String
  passwordHash   String
  role           String              @default("USER")
  status         String              @default("Active")
  reminderEmails Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  companyAccess  UserCompanyAccess[]
  auditLogs      AuditLog[]
}

model UserCompanyAccess {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  tenantKey  String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@unique([userId, tenantKey])
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id])
  tenantKey  String?
  action     String
  entity     String?
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())
}

model BackupRun {
  id          Int       @id @default(autoincrement())
  status      String
  localPath   String?
  cloudPath   String?
  message     String?
  createdAt   DateTime  @default(now())
}
